# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Credentials that do NOT start with ".env" and so slip past the pattern above.
# env.txt holds the Supabase service_role key, which bypasses RLS entirely.
env.txt
*.env
secrets*.txt

# Source workbooks dropped in the repo root for the expenses backfill. These are
# not just data: "Combined Live Backlinks.xlsx" carries ~810 rows of plaintext
# account credentials (Mail Id / Password / User Name) and the Upwork sheet has
# email/password pairs, so they must never enter version control — the importer
# deliberately drops those columns.
#
# Root-scoped on purpose: public/templates/*.csv are shipped app assets and
# Pricing/ has a tracked workbook, so a blanket *.xlsx/*.csv would fight them.
/*.xlsx
/*.xls
/*.csv
# Excel's lock files ("~$Book.xlsx")
~$*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/

# dev logs
*.log
